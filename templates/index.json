, i){\n      dot.classList.toggle(\"is-active\", i === index);\n    });\n  }\n\n  // Bepaal actieve slide via dichtstbijzijnde offsetLeft (stabieler dan track width)\n  function getClosestIndex(){\n    var x = track.scrollLeft;\n    var closest = 0;\n    var minDist = Infinity;\n    blocks.forEach(function(el, i){\n      var dist = Math.abs(el.offsetLeft - x);\n      if(dist < minDist){\n        minDist = dist;\n        closest = i;\n      }\n    });\n    return closest;\n  }\n\n  var ticking = false;\n  track.addEventListener(\"scroll\", function(){\n    if(ticking) return;\n    ticking = true;\n    requestAnimationFrame(function(){\n      setActive(getClosestIndex());\n      ticking = false;\n    });\n  });\n\n  // Tap dot to scroll\n  dotsWrap.addEventListener(\"click\", function(e){\n    var t = e.target;\n    if(!t || !t.classList.contains(\"tcwi-dot\")) return;\n    var idx = parseInt(t.getAttribute(\"data-index\"), 10) || 0;\n    var target = blocks[idx];\n    if(!target) return;\n    track.scrollTo({ left: target.offsetLeft, behavior: \"smooth\" });\n  });\n})();\n</script>\n\n\n</div>"
