          "settings": {
            "code": "<div class=\"product-block\">\n                      <!-- START: Stock pulse — random 2–5 per product -->\n<div class=\"stock-pulse-wrap\" aria-hidden=\"false\" role=\"status\">\n  <p class=\"stock-line\" aria-live=\"polite\">\n    <span class=\"pulse-dot custom-red\" aria-hidden=\"true\"></span>\n    <span class=\"stock-text\">\n      Only <span class=\"stock-random\">4</span> left in stock.\n    </span>\n  </p>\n</div>\n\n<style>\n.stock-pulse-wrap {\n  margin: 8px 0;\n  width: 100%;\n  box-sizing: border-box;\n}\n\n.stock-line {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  font-family: \"Work Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif;\n  font-size: 14px;\n  color: #c40000;\n  margin: 0;\n  justify-content: flex-start;\n  width: 100%;\n}\n\n.pulse-dot {\n  width: 9px;\n  height: 9px;\n  border-radius: 50%;\n  display: inline-block;\n  flex: 0 0 auto;\n  position: relative;\n}\n\n.pulse-dot.custom-red {\n  background: #c40000;\n  box-shadow: 0 0 0 0 rgba(196, 0, 0, 0.18);\n  animation: pulse-red 1.6s infinite;\n}\n\n@keyframes pulse-red {\n  0% {\n    box-shadow: 0 0 0 0 rgba(196, 0, 0, 0.18);\n  }\n  70% {\n    box-shadow: 0 0 0 9px rgba(196, 0, 0, 0);\n  }\n  100% {\n    box-shadow: 0 0 0 0 rgba(196, 0, 0, 0);\n  }\n}\n\n.stock-text {\n  font-size: 15px;\n  line-height: 1.2;\n  color: #c40000;\n  font-weight: 500;\n}\n\n/* Mobile */\n@media (max-width: 600px) {\n  .stock-text {\n    font-size: 14px;\n  }\n\n  .pulse-dot {\n    width: 8px;\n    height: 8px;\n  }\n}\n</style>\n\n<script>\n(function(){\n  var productId = \"15643046445382\";\n  var key = \"stockRandom_\" + productId;\n  \n  var existing = localStorage.getItem(key);\n  var number;\n\n  if (existing) {\n    number = existing;\n  } else {\n    number = Math.floor(Math.random() * 4) + 2; // 2–5\n    localStorage.setItem(key, number);\n  }\n\n  var el = document.querySelector(\".stock-random\");\n  if (el) el.textContent = number;\n})();\n</script>\n<!-- END: Stock pulse -->\n                    </div>"
