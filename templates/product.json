      "name": "🚀SP - Custom HTML",
      "settings": {
        "title": "",
        "custom_html": "<div id=\"shopify-section-template--28491604001094__text_with_icons_8Jxq4Y\" class=\"shopify-section index-section\">\n<div class=\"text-with-icons\" data-section-id=\"template--28491604001094__text_with_icons_8Jxq4Y\" data-section-type=\"text-with-icons\">\n  <div class=\"page-width\">\n<div class=\"text-with-icons__blocks has-3-per-row\" data-block-count=\"3\" id=\"tcwi-track-template--28491604001094__text_with_icons_8Jxq4Y\">\n      \n        <div class=\"text-with-icons__block text-center\">\n          <div class=\"text-with-icons__block-icon\">\n            \n                <svg aria-hidden=\"true\" focusable=\"false\" role=\"presentation\" class=\"icon icon-tcwi-truck\" viewbox=\"0 0 100 100\"><path d=\"m44.36 67.09-2.17.01h20.46V28.83H22.27v3.93m0 23.71V67.1h8.78l-2.18-.01\"></path><path d=\"M36.62 59.5a5.83 5.83 0 0 0-5.84 5.83 5.84 5.84 0 0 0 11.68 0 5.84 5.84 0 0 0-5.84-5.83Zm41.38 0a5.84 5.84 0 0 0-5.85 5.83 5.84 5.84 0 0 0 11.68 0A5.83 5.83 0 0 0 78 59.5Z\"></path><path d=\"m70.26 67.09 2.17.01h-9.78V34.03h12.31l15.06 15.06h4.67V67.1H83.57l2.18-.01\"></path><path d=\"M66.95 49.1V38h5.49l11.04 11.03-16.53.07zm-38.69-4.57H5.31m27.5-6.72h-15.3m15.3 13.44h-15.3\"></path></svg>\n              \n          </div>\n\n          <div class=\"text-with-icons__block-title\">\n            <h3>FREE SHIPPING</h3>\n          </div>\n\n          <div class=\"text-with-icons__block-text\">\n            <p>Free shipping on every order across Canada this week only. We'll deliver straight to your door, safely and at no extra cost.<br><br></p>\n          </div>\n        </div>\n      \n        <div class=\"text-with-icons__block text-center\">\n          <div class=\"text-with-icons__block-icon\">\n            \n                <img class=\"icon icon-tcwi-returns-img\" src=\"https://cdn.shopify.com/s/files/1/0814/1160/4806/files/undo_120x_b48905b2-4194-43ea-9d92-8b6afe6fdbb3.svg?v=1783624425\" alt=\"\" loading=\"lazy\">\n              \n          </div>\n\n          <div class=\"text-with-icons__block-title\">\n            <h3>30-DAY MONEY-BACK GUARANTEE</h3>\n          </div>\n\n          <div class=\"text-with-icons__block-text\">\n            <p>Shop with confidence. We offer a 30-day money-back guarantee if you’re not completely satisfied.</p>\n          </div>\n        </div>\n      \n        <div class=\"text-with-icons__block text-center\">\n          <div class=\"text-with-icons__block-icon\">\n            \n                <svg aria-hidden=\"true\" focusable=\"false\" role=\"presentation\" class=\"icon icon-tcwi-payment\" xmlns=\"http://www.w3.org/2000/svg\" viewbox=\"0 0 50 50\" width=\"50px\" height=\"50px\" fill=\"currentColor\"><path d=\"M 7 9 C 4.2504839 9 2 11.250484 2 14 L 2 36 C 2 38.749516 4.2504839 41 7 41 L 25 41 L 29.636719 41 C 29.389719 40.366 29.166797 39.699 28.966797 39 L 25 39 L 7 39 C 5.3315161 39 4 37.668484 4 36 L 4 21 L 46 21 L 46 24 L 46 27.859375 C 46.562 28.091375 47.21 28.321922 48 28.544922 L 48 24 L 48 14 C 48 11.250484 45.749516 9 43 9 L 7 9 z M 7 11 L 43 11 C 44.668484 11 46 12.331516 46 14 L 46 16 L 4 16 L 4 14 C 4 12.331516 5.3315161 11 7 11 z M 9 24 L 9 26 L 25 26 L 25 24 L 9 24 z M 40 27.900391 C 38.5 27.900391 37.500781 28.4 36.300781 29 C 35.100781 29.6 33.600781 30.300391 30.800781 30.900391 L 30 31.099609 L 30 31.900391 C 30 44.900391 39.2 49.600781 39.5 49.800781 L 40 50 L 40.5 49.800781 C 40.9 49.600781 50.44 44.500391 50 31.900391 L 50 31.099609 L 49.199219 30.900391 C 46.399219 30.300391 44.899219 29.6 43.699219 29 C 42.499219 28.4 41.5 27.900391 40 27.900391 z M 40 29.900391 C 41.1 29.900391 41.700781 30.200781 42.800781 30.800781 C 44.000781 31.300781 45.5 32.099219 48 32.699219 C 47.7 41.999219 41.7 46.599219 40 47.699219 C 38.2 46.699219 32.3 42.399219 32 32.699219 C 34.6 32.099219 36.099219 31.300781 37.199219 30.800781 C 38.299219 30.200781 38.9 29.900391 40 29.900391 z\"></path></svg>\n            \n          </div>\n\n          <div class=\"text-with-icons__block-title\">\n            <h3>SECURE CHECKOUT</h3>\n          </div>\n\n          <div class=\"text-with-icons__block-text\">\n            <p>Enjoy a secure checkout with credit card or PayPal. We want you to feel completely confident every step of the way.</p>\n          </div>\n        </div>\n      \n    </div>\n<div class=\"tcwi-dots\" id=\"tcwi-dots-template--28491604001094__text_with_icons_8Jxq4Y\" aria-hidden=\"true\">\n<span class=\"tcwi-dot is-active\" data-index=\"0\"></span><span class=\"tcwi-dot\" data-index=\"1\"></span><span class=\"tcwi-dot\" data-index=\"2\"></span>\n</div>\n<div class=\"text-with-icons__button\"></div>\n  </div>\n</div>\n<style data-shopify=\"\">\n  #shopify-section-template--28491604001094__text_with_icons_8Jxq4Y .icon {\n    color: #000000;\n  }\n</style>\n\n<style data-shopify=\"\">\n  /* Compacte desktop styling voor deze section */\n  #shopify-section-template--28491604001094__text_with_icons_8Jxq4Y {\n    margin-bottom: 0 !important;\n    padding-bottom: 18px !important;\n  }\n\n  #shopify-section-template--28491604001094__text_with_icons_8Jxq4Y .text-with-icons {\n    margin-bottom: 0 !important;\n    padding-bottom: 0 !important;\n  }\n\n  #shopify-section-template--28491604001094__text_with_icons_8Jxq4Y .text-with-icons__blocks {\n    margin-bottom: 0 !important;\n  }\n\n  #shopify-section-template--28491604001094__text_with_icons_8Jxq4Y .text-with-icons__block-icon svg,\n  #shopify-section-template--28491604001094__text_with_icons_8Jxq4Y .text-with-icons__block-icon img {\n    width: 50px;\n    height: 50px;\n  }\n\n  #shopify-section-template--28491604001094__text_with_icons_8Jxq4Y .text-with-icons__block-icon img {\n    display: inline-block;\n    object-fit: contain;\n  }\n\n  #shopify-section-template--28491604001094__text_with_icons_8Jxq4Y .text-with-icons__block-title h3 {\n    font-size: 0.85em;\n    font-weight: 700 !important;\n  }\n\n  #shopify-section-template--28491604001094__text_with_icons_8Jxq4Y .text-with-icons__block-text {\n    font-size: 0.75em;\n  }\n</style>\n\n<style data-shopify=\"\">\n  /* ===== MOBILE: 1 KAART PER KEER + SWIPE ===== */\n  @media (max-width: 749px){\n    /* Forceer carousel op het track-element (theme overrides afkappen) */\n    #shopify-section-template--28491604001094__text_with_icons_8Jxq4Y #tcwi-track-template--28491604001094__text_with_icons_8Jxq4Y{\n      display: flex !important;\n      flex-direction: row !important;\n      flex-wrap: nowrap !important;\n      overflow-x: auto !important;\n      overflow-y: hidden !important;\n      -webkit-overflow-scrolling: touch;\n      scroll-snap-type: x mandatory;\n      scroll-behavior: smooth;\n      gap: 0 !important;\n      padding: 0 !important;\n      margin: 0 !important;\n    }\n\n    /* Reset theme spacing die jouw gigantische witruimte veroorzaakt */\n    #shopify-section-template--28491604001094__text_with_icons_8Jxq4Y #tcwi-track-template--28491604001094__text_with_icons_8Jxq4Y .text-with-icons__block{\n      flex: 0 0 100% !important;\n      width: 100% !important;\n      max-width: 100% !important;\n      scroll-snap-align: center;\n      box-sizing: border-box;\n      margin: 0 !important;\n      padding: 0 18px !important; /* zijkant padding zoals in screenshot */\n    }\n\n    /* Vaak heeft theme extra bottom margins op children: kill it */\n    #shopify-section-template--28491604001094__text_with_icons_8Jxq4Y #tcwi-track-template--28491604001094__text_with_icons_8Jxq4Y .text-with-icons__block-title,\n    #shopify-section-template--28491604001094__text_with_icons_8Jxq4Y #tcwi-track-template--28491604001094__text_with_icons_8Jxq4Y .text-with-icons__block-text,\n    #shopify-section-template--28491604001094__text_with_icons_8Jxq4Y #tcwi-track-template--28491604001094__text_with_icons_8Jxq4Y .text-with-icons__block-icon{\n      margin-bottom: 0 !important;\n    }\n\n    #shopify-section-template--28491604001094__text_with_icons_8Jxq4Y .text-with-icons__block-icon svg,\n    #shopify-section-template--28491604001094__text_with_icons_8Jxq4Y .text-with-icons__block-icon img {\n      width: 50px;\n      height: 50px;\n    }\n\n    /* Dots */\n    #shopify-section-template--28491604001094__text_with_icons_8Jxq4Y .tcwi-dots{\n      display:flex;\n      justify-content:center;\n      gap:10px;\n      margin-top: 10px;\n      margin-bottom: 0;\n    }\n    #shopify-section-template--28491604001094__text_with_icons_8Jxq4Y .tcwi-dot{\n      width:10px;\n      height:10px;\n      border-radius:50%;\n      background:#d9d9d9;\n    }\n    #shopify-section-template--28491604001094__text_with_icons_8Jxq4Y .tcwi-dot.is-active{\n      background:#111;\n    }\n\n    /* scrollbar verbergen */\n    #shopify-section-template--28491604001094__text_with_icons_8Jxq4Y #tcwi-track-template--28491604001094__text_with_icons_8Jxq4Y::-webkit-scrollbar{ display:none; }\n    #shopify-section-template--28491604001094__text_with_icons_8Jxq4Y #tcwi-track-template--28491604001094__text_with_icons_8Jxq4Y{ scrollbar-width:none; }\n  }\n</style>\n\n<script>\n(function(){\n  var sectionId = \"template--28491604001094__text_with_icons_8Jxq4Y\";\n  var root = document.getElementById(\"shopify-section-\" + sectionId);\n  if(!root) return;\n\n  var track = document.getElementById(\"tcwi-track-\" + sectionId);\n  if(!track) return;\n\n  var blocks = Array.prototype.slice.call(track.querySelectorAll(\".text-with-icons__block\"));\n  if(blocks.length <= 1) return;\n\n  var dotsWrap = document.getElementById(\"tcwi-dots-\" + sectionId);\n  if(!dotsWrap) return;\n\n  // Build dots\n  dotsWrap.innerHTML = \"\";\n  blocks.forEach(function(_, i){\n    var d = document.createElement(\"span\");\n    d.className = \"tcwi-dot\" + (i === 0 ? \" is-active\" : \"\");\n    d.setAttribute(\"data-index\", String(i));\n    dotsWrap.appendChild(d);\n  });\n\n  var dots = Array.prototype.slice.call(dotsWrap.querySelectorAll(\".tcwi-dot\"));\n\n  function setActive(index){\n    dots.forEach(function(dot, i){\n      dot.classList.toggle(\"is-active\", i === index);\n    });\n  }\n\n  // Bepaal actieve slide via dichtstbijzijnde offsetLeft (stabieler dan track width)\n  function getClosestIndex(){\n    var x = track.scrollLeft;\n    var closest = 0;\n    var minDist = Infinity;\n    blocks.forEach(function(el, i){\n      var dist = Math.abs(el.offsetLeft - x);\n      if(dist < minDist){\n        minDist = dist;\n        closest = i;\n      }\n    });\n    return closest;\n  }\n\n  var ticking = false;\n  track.addEventListener(\"scroll\", function(){\n    if(ticking) return;\n    ticking = true;\n    requestAnimationFrame(function(){\n      setActive(getClosestIndex());\n      ticking = false;\n    });\n  });\n\n  // Tap dot to scroll\n  dotsWrap.addEventListener(\"click\", function(e){\n    var t = e.target;\n    if(!t || !t.classList.contains(\"tcwi-dot\")) return;\n    var idx = parseInt(t.getAttribute(\"data-index\"), 10) || 0;\n    var target = blocks[idx];\n    if(!target) return;\n    track.scrollTo({ left: target.offsetLeft, behavior: \"smooth\" });\n  });\n})();\n</script>\n\n\n</div>"
